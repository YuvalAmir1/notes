diff --git a/user-lisp/helheim/00-core/helheim-nix.el b/user-lisp/helheim/00-core/helheim-nix.el
new file mode 100644
index 0000000..bff13ce
--- /dev/null
+++ b/user-lisp/helheim/00-core/helheim-nix.el
@@ -0,0 +1,21 @@
+;;; helheim-nix.el                -*- lexical-binding: t; no-byte-compile: t -*-
+;;; Commentary:
+;;
+;; Packages installed outside Emacs, by Nix or Guix. They are where package.el
+;; looks already; it only has to activate them (load their autoloads), which
+;; early-init.el left for later by turning off `package-enable-at-startup'.
+;;
+;;; Code:
+
+(package-activate-all)
+
+(defalias 'elpaca-wait #'ignore)
+
+(defun helheim-update ()
+  "Explain that packages are updated outside Emacs."
+  (interactive)
+  (user-error "Packages come from Nix or Guix: update them there"))
+
+(defalias 'helheim-update-all #'helheim-update)
+
+(provide 'helheim-nix)
